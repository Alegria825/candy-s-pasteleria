---
import Base from '../../layouts/Base.astro';
import Switcher from '../../components/shared/Switcher.astro';
import Layers from '../../components/shared/Layers.astro';
import { site } from '../../data/site';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Problema from './Problema.astro';
import Pasteles from './Pasteles.astro';
import Antojos from './Antojos.astro';
import Proceso from './Proceso.astro';
import Testimonios from './Testimonios.astro';
import Visitanos from './Visitanos.astro';
import Faq from './Faq.astro';
import Cierre from './Cierre.astro';
import './styles.css';
const fonts =
  'https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Jost:wght@400;500;600&display=swap';
---

<Base fontsHref={fonts}>
  <Switcher current="cacao-nocturno" />
  <Header />
  <main>
    <Hero />
    <Problema />
    <Pasteles />
    <Antojos />
    <Proceso />
    <Testimonios />
    <Visitanos />
    <Faq />
  </main>
  <Cierre />
  <Layers />
  <script>
    import './ui.js';
  </script>
</Base>
