---
import { faq } from '../../data/faq';
---

<section>
  <div class="w">
    <h2 class="rv" id="faq">
      Preguntas <em>frecuentes</em>
    </h2>
    {faq.map((q) => (
      <details class="rv">
        <summary>{q.pregunta}</summary>
        <p>{q.respuesta}</p>
      </details>
    ))}
  </div>
</section>
